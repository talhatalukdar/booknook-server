# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (use the same cluster the client's BetterAuth adapter uses, or a separate one)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=booknook

# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_URL=http://localhost:3000

# BetterAuth JWT verification (must match the client's BETTER_AUTH_URL, the JWT issuer/audience)
BETTER_AUTH_URL=http://localhost:3000
# Optional overrides (defaults: JWKS = BETTER_AUTH_URL/api/auth/jwks, issuer = audience = BETTER_AUTH_URL)
# JWT_JWKS_URL=
# JWT_ISSUER=
# JWT_AUDIENCE=
